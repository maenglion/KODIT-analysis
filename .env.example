# Server-only database connection. Never prefix these with NEXT_PUBLIC_.
KODIT_DATABASE_URL=postgresql://example_user:example_password@example.invalid:5432/example_db

# Optional local verification fallback through the Supabase Management API.
KODIT_SUPABASE_PROJECT_REF=exampleprojectref
KODIT_SUPABASE_ACCESS_TOKEN=sbp_example_only_not_a_real_token
