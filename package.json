{
  "name": "kodit-analysis",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "check:schema": "node tools/check-schema-contract.mjs",
    "check:regeneration": "node tools/check-regeneration-contract.mjs",
    "check:vertical": "node tools/check-vertical-slice.mjs",
    "check:regulations": "node --experimental-strip-types tools/check-regulation-table.mjs",
    "check:schedule": "node tools/check-scheduled-collection.mjs",
    "check:approved": "node --experimental-strip-types tools/check-approved-releases.mjs",
    "check:reconstructed": "node tools/check-reconstructed-evaluation.mjs",
    "check:technical-specs": "node tools/check-technical-specs.mjs",
    "check:extractions": "node tools/extractions/check_document_extraction_contract.mjs",
    "test:extractions:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/extractions/run_document_extraction_integration.ps1",
    "backfill:extractions": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/extractions/run_document_extraction_backfill.ps1",
    "check:mentions": "node tools/mentions/check_extraction_mention_contract.mjs",
    "test:mentions": "python tools/mentions/run_mention_unit_tests.py",
    "backfill:mentions": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/mentions/run_extraction_mention_backfill.ps1",
    "check:labels": "node tools/labels/check_lexical_label_contract.mjs",
    "backfill:labels": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/labels/run_lexical_label_backfill.ps1",
    "check:organizations": "node tools/organizations/check_organization_lineage_contract.mjs",
    "backfill:organizations": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/organizations/run_organization_lineage_backfill.ps1",
    "check:residual-analysis": "node tools/publish/check_department_residual_analysis_contract.mjs",
    "test:residual-analysis:http": "node tools/publish/check_department_residual_analysis_http.mjs",
    "check:t065": "node tools/analytics/check_t065_contract.mjs",
    "check:t066": "node tools/organizations/check_org_work_attribution_contract.mjs",
    "backfill:t066": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/organizations/run_org_work_attribution_backfill.ps1",
    "check:t067": "node tools/organizations/check_historical_org_evidence_contract.mjs",
    "test:t067:http": "node tools/organizations/check_historical_org_evidence_http.mjs",
    "check:t07a": "node tools/analytics/check_topic_v1_contract.mjs",
    "test:t07a:http": "node tools/analytics/check_topic_v1_http.mjs",
    "build:t07b-review": "node tools/analytics/build_topic_boundary_review_v1.mjs",
    "check:t07b": "node tools/analytics/check_topic_boundary_audit_v1.mjs",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "test:remote-access": "node supabase/tests/remote_access_contract.mjs",
    "test:remote-approved": "node supabase/tests/remote_approved_release_contract.mjs"
  },
  "devDependencies": {
    "pg": "^8.16.3"
  }
}
